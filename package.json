{
  "name": "ox64",
  "version": "0.1.0",
  "private": true,
  "description": "Mock Trading Platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit",
    "d1:budget": "node scripts/d1-budget.mjs",
    "sim:bot": "esbuild scripts/sim-bot.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/ox64-sim.mjs --log-level=warning && node node_modules/.cache/ox64-sim.mjs",
    "d1:check": "npx wrangler d1 insights ox64 --sort-by writes --count 5 --timePeriod 1d --json"
  },
  "dependencies": {
    "lightweight-charts": "^4.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rxjs": "^7.8.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
